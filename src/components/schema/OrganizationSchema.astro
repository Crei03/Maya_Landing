---
interface Props {
	siteName: string;
	description: string;
}

const { siteName, description } = Astro.props;

const schema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: siteName,
	description,
	areaServed: {
		"@type": "Country",
		name: "Panamá"
	},
	sameAs: [
		"https://www.instagram.com/mayalogistictech/",
		"https://www.facebook.com/mayalogistictech/",
		"https://x.com/mayalogistictech/",
		"https://www.tiktok.com/@mayalogistictech",
		"https://www.linkedin.com/company/mayalogistictech/"
	]
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
